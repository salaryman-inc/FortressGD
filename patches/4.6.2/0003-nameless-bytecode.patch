+
+#ifdef FORTRESSGD_NAMELESS
+	// FGDN runtime names must be loaded before _binary_to_token (IDENTIFIER lookup).
+	if (identifier_count == 0 && total_len >= 8 && b[0] == 'F' && b[1] == 'G' && b[2] == 'D' && b[3] == 'N') {
+		uint32_t n = decode_uint32(b + 4);
+		b += 8;
+		total_len -= 8;
