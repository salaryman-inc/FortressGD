+				uint8_t tmp[4];
+				for (uint32_t k = 0; k < 4; k++) {
+					tmp[k] = b[j * 4 + k] ^ 0xb6;
+				}
+				cs.write[j] = decode_uint32(tmp);
+			}
+			String s = String::utf32(Span(reinterpret_cast<const char32_t *>(cs.ptr()), len));
+			b += len * 4;
+			total_len -= len * 4;
+			identifiers.write[i] = s;
+		}
 	}
