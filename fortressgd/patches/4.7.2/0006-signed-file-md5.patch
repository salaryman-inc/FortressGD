+		} else {
+			CryptoCore::MD5Context fgd_ctx;
+			fgd_ctx.start();
+			uint8_t fgd_buf[16384];
+			uint64_t fgd_left = pf.size;
+			while (fgd_ok && fgd_left > 0) {
+				const uint64_t fgd_n = MIN(fgd_left, (uint64_t)sizeof(fgd_buf));
+				fgd_ok = f->get_buffer(fgd_buf, fgd_n) == fgd_n;
+				if (fgd_ok) {
+					fgd_ctx.update(fgd_buf, fgd_n);
+				}
+				fgd_left -= fgd_n;
+			}
