+/**************************************************************************/
+/*  fortressgd_kdf.cpp                                                    */
+/**************************************************************************/
+/* FortressGD pack key: reassembled from masked shards (DESIGN.md §5.2).   */
+/**************************************************************************/
+
+#include "fortressgd_kdf.h"
+
+#include "dialect.gen.h"
+
+void fortressgd_wipe(void *p, size_t n) {
+	volatile uint8_t *v = static_cast<volatile uint8_t *>(p);
+	for (size_t i = 0; i < n; i++) {
+		v[i] = 0;
+	}
+}
+
+/* The pack AES key, FGD-KDF-1(secret, salt), is decoded by fgd_derive_key() from
+ * the per-build generated code in fortressgd_gen.cpp (generator v2). The project
+ * secret is never compiled in, so nothing in the binary yields the secret or the
+ * pack-signing seed. The editor build compiles in no key, so its fgd_derive_key()
+ * returns zeros. */
+void fortressgd_derive_key(uint8_t r_key[32]) {
+	fgd_derive_key(r_key);
+}
+
+static String fortressgd_decode_msg(const uint8_t *p_enc, size_t p_len) {
+	char buf[96];
+	if (p_len >= sizeof(buf)) {
+		return String();
+	}
+	for (size_t i = 0; i < p_len; i++) {
+		buf[i] = static_cast<char>(p_enc[i] ^ 0xA5);
+	}
+	buf[p_len] = 0;
+	String s = String::utf8(buf, (int)p_len);
+	fortressgd_wipe(buf, sizeof(buf));
+	return s;
+}
+
+String fortressgd_msg_enc_dir() {
+	static const uint8_t enc[] = {
+		0xE6, 0xC4, 0xCB, 0x82, 0xD1, 0x85, 0xCA, 0xD5, 0xC0, 0xCB, 0x85, 0xC0, 0xCB, 0xC6, 0xD7, 0xDC,
+		0xD5, 0xD1, 0xC0, 0xC1, 0x85, 0xD5, 0xC4, 0xC6, 0xCE, 0x85, 0xC1, 0xCC, 0xD7, 0xC0, 0xC6, 0xD1,
+		0xCA, 0xD7, 0xDC, 0x8B
+	};
+	return fortressgd_decode_msg(enc, sizeof(enc));
+}
+
+String fortressgd_msg_enc_file() {
+	static const uint8_t enc[] = {
+		0xE6, 0xC4, 0xCB, 0x82, 0xD1, 0x85, 0xCA, 0xD5, 0xC0, 0xCB, 0x85, 0xC0, 0xCB, 0xC6, 0xD7, 0xDC,
+		0xD5, 0xD1, 0xC0, 0xC1, 0x85, 0xD5, 0xC4, 0xC6, 0xCE, 0x88, 0xD7, 0xC0, 0xC3, 0xC0, 0xD7, 0xC0,
+		0xCB, 0xC6, 0xC0, 0xC1, 0x85, 0xC3, 0xCC, 0xC9, 0xC0, 0x85, 0x87, 0x80, 0xD6, 0x87, 0x85, 0xC3,
+		0xD7, 0xCA, 0xC8, 0x85, 0xD5, 0xC4, 0xC6, 0xCE, 0x85, 0x87, 0x80, 0xD6, 0x87, 0x8B
+	};
+	return fortressgd_decode_msg(enc, sizeof(enc));
+}
+
+String fortressgd_msg_enc_file_err() {
+	static const uint8_t enc[] = {
+		0xE6, 0xC4, 0xCB, 0x82, 0xD1, 0x85, 0xCA, 0xD5, 0xC0, 0xCB, 0x85, 0xC0, 0xCB, 0xC6, 0xD7, 0xDC,
+		0xD5, 0xD1, 0xC0, 0xC1, 0x85, 0xD5, 0xC4, 0xC6, 0xCE, 0x88, 0xD7, 0xC0, 0xC3, 0xC0, 0xD7, 0xC0,
+		0xCB, 0xC6, 0xC0, 0xC1, 0x85, 0xC3, 0xCC, 0xC9, 0xC0, 0x85, 0x87, 0x80, 0xD6, 0x87, 0x85, 0xC3,
+		0xD7, 0xCA, 0xC8, 0x85, 0xD5, 0xC4, 0xC6, 0xCE, 0x85, 0x87, 0x80, 0xD6, 0x87, 0x85, 0xC1, 0xD0,
+		0xC0, 0x85, 0xD1, 0xCA, 0x85, 0xC0, 0xD7, 0xD7, 0xCA, 0xD7, 0x85, 0x87, 0x80, 0xD6, 0x87, 0x8B
+	};
+	return fortressgd_decode_msg(enc, sizeof(enc));
+}
